{
  "name": "clipnote",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ClipNote 桌面文件工作台与接入验证工具",
  "engines": {
    "node": ">=24.14.1"
  },
  "scripts": {
    "test": "node --test tests/unit/*.test.ts tests/integration/*.test.mjs",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node tools/build-desktop.mjs",
    "start": "node tools/start-desktop.mjs",
    "dev": "npm run build && npm start",
    "verify:runtime": "node tools/verify-runtime.mjs",
    "verify:electron": "node tools/run-electron-verification.mjs",
    "verify:login": "node tools/run-electron-verification.mjs --login",
    "verify:api": "node tools/verify-api.mjs",
    "verify:smartsub": "node tools/verify-smartsub.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.0.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
